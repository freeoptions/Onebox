<Window x:Class="OneBox.App.AccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加账号" Width="520"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="32,28,32,30">
    <TextBlock Text="添加邮箱账号" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20" />
    <ComboBox x:Name="ProviderBox" Height="40" SelectedIndex="0" SelectionChanged="OnProviderChanged" Margin="0,0,0,20">
      <ComboBoxItem Content="QQ 邮箱"/><ComboBoxItem Content="网易邮箱（163 / 126 / yeah）"/><ComboBoxItem Content="Gmail"/>
    </ComboBox>
    <StackPanel x:Name="StandardFieldsPanel">
      <TextBlock Text="邮箱地址" Margin="0,0,0,6"/>
      <TextBox x:Name="AddressBox" Height="38" Padding="9,6" Margin="0,0,0,16"/>
      <TextBlock Text="显示名称" Margin="0,0,0,6"/>
      <TextBox x:Name="NameBox" Height="38" Padding="9,6" Margin="0,0,0,16"/>
      <TextBlock Text="客户端授权码" Margin="0,0,0,6"/>
      <PasswordBox x:Name="SecretBox" Height="38" Padding="9,6"/>
      <TextBlock x:Name="HelpText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                 FontSize="12" Margin="0,14,0,0"/>
    </StackPanel>
    <StackPanel x:Name="GmailPanel" Visibility="Collapsed">
      <TextBlock Text="接下来会在系统浏览器中登录 Google。授权完成后，OneBox 会自动识别邮箱地址并保存登录凭据。"
                 TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,14"/>
      <StackPanel x:Name="GoogleSetupPanel" Visibility="Collapsed">
        <Border Background="{StaticResource SelectedBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <TextBlock Text="先在自己的 Google Cloud 项目中启用 Gmail API，创建“桌面应用”OAuth 客户端。可直接导入下载的客户端 JSON，也可填写对应的 ID 和密钥。"
                     TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" LineHeight="21"/>
        </Border>
        <Button Content="导入 Google 桌面客户端 JSON" Click="OnImportGoogleClient" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <TextBlock Text="Google 桌面 OAuth 客户端 ID" Margin="0,0,0,6"/>
        <TextBox x:Name="ClientIdBox" Height="38" Padding="9,6" Margin="0,0,0,8"/>
        <TextBlock Text="对应的客户端密钥" Margin="0,4,0,6"/>
        <PasswordBox x:Name="ClientSecretBox" Height="38" Padding="9,6" Margin="0,0,0,6"/>
        <TextBlock Text="密钥只保存到 Windows 凭据管理器，不复制导入的 JSON。"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="1. 启用 Gmail API" Click="OnOpenGmailApi" Padding="0,7" Margin="0,0,18,0"/>
          <Button Content="2. 创建桌面客户端" Click="OnOpenGoogleSetup" Padding="0,7"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Text="以后会自动续期；若你在 Google Cloud 中将应用保持为“测试”，授权通常 7 天后到期。"
                 TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="取消" Click="OnCancel" Margin="0,0,8,0"/>
      <Button x:Name="AcceptButton" Content="验证并添加" Style="{StaticResource AccentButton}" Click="OnAccept"/>
    </StackPanel>
  </StackPanel>
</Window>
