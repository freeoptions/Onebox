<Window x:Class="OneBox.App.AccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="添加账号" Width="540" Style="{StaticResource AppWindow}"
        SizeToContent="Height" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
  <StackPanel Margin="32,28,32,30">
    <TextBlock Text="连接你的邮箱" FontSize="{DynamicResource FontSize25}" FontWeight="SemiBold"/>
    <TextBlock Text="将邮件集中收纳，保留各账号独立授权。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,24"/>
    <ComboBox x:Name="ProviderBox" MinHeight="40" SelectedIndex="0" SelectionChanged="OnProviderChanged" Margin="0,0,0,20">
      <ComboBoxItem Content="QQ邮箱"/><ComboBoxItem Content="网易邮箱（163 / 126 / yeah）"/><ComboBoxItem Content="Gmail"/>
    </ComboBox>
    <StackPanel x:Name="StandardFieldsPanel">
      <TextBlock Text="邮箱地址" Margin="0,0,0,6"/>
      <TextBox x:Name="AddressBox" MinHeight="38" Padding="9,6" Margin="0,0,0,16"/>
      <TextBlock Text="显示名称" Margin="0,0,0,6"/>
      <TextBox x:Name="NameBox" MinHeight="38" Padding="9,6" Margin="0,0,0,16"/>
      <TextBlock x:Name="SecretLabel" Text="客户端授权码" Margin="0,0,0,6"/>
      <PasswordBox x:Name="SecretBox" MinHeight="38" Padding="9,6"/>
      <TextBlock x:Name="HelpText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                 FontSize="{DynamicResource FontSize12}" Margin="0,14,0,0"/>
      <Button x:Name="AppPasswordButton" Content="生成Google应用专用密码" Click="OnOpenAppPasswords" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel x:Name="GmailPanel" Visibility="Collapsed">
      <TextBlock Text="接下来会在系统浏览器中登录Google。授权完成后，OneBox会自动识别邮箱地址并保存登录凭据。"
                 TextWrapping="Wrap" LineHeight="{DynamicResource HelpLineHeight}" Margin="0,0,0,14"/>
      <StackPanel x:Name="GoogleSetupPanel" Visibility="Collapsed">
        <Border Background="{StaticResource SelectedBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
          <TextBlock Text="先在自己的Google Cloud项目中启用Gmail API，创建“桌面应用”OAuth客户端。可直接导入下载的客户端JSON，也可填写对应的ID和密钥。"
                     TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" LineHeight="{DynamicResource HelpLineHeight}"/>
        </Border>
        <Button Content="导入Google桌面客户端JSON" Click="OnImportGoogleClient" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <TextBlock Text="Google桌面OAuth客户端ID" Margin="0,0,0,6"/>
        <TextBox x:Name="ClientIdBox" MinHeight="38" Padding="9,6" Margin="0,0,0,8"/>
        <TextBlock Text="对应的客户端密钥" Margin="0,4,0,6"/>
        <PasswordBox x:Name="ClientSecretBox" MinHeight="38" Padding="9,6" Margin="0,0,0,6"/>
        <TextBlock Text="密钥只保存到Windows凭据管理器，不复制导入的JSON。"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="{DynamicResource FontSize12}" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="1. 启用Gmail API" Click="OnOpenGmailApi" Padding="0,7" Margin="0,0,18,0"/>
          <Button Content="2. 创建桌面客户端" Click="OnOpenGoogleSetup" Padding="0,7"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Text="以后会自动续期；若你在Google Cloud中将应用保持为“测试”，授权通常7天后到期。"
                 TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="{DynamicResource FontSize12}" Margin="0,12,0,0"/>
    </StackPanel>
    <ProgressBar x:Name="ValidationProgress" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,18,0,0"/>
    <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="取消" Click="OnCancel" Margin="0,0,8,0"/>
      <Button x:Name="AcceptButton" Content="验证并添加" Style="{StaticResource AccentButton}" Click="OnAccept"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
