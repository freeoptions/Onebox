<Window x:Class="OneBox.App.ComposeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="写邮件" Width="780" Height="700" Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner" MinWidth="600" MinHeight="500" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="写邮件" FontSize="{DynamicResource FontSize25}" FontWeight="SemiBold" Margin="0,0,0,26"/>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="发件人" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="FromBox" DisplayMemberPath="Address" MinHeight="36"/></Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="收件人" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ToBox" Padding="8,5" MinHeight="36" ToolTip="多个地址用英文逗号分隔"/></Grid>
    <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="主题" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="SubjectBox" Padding="8,5" MinHeight="36"/></Grid>
    <TextBox Grid.Row="4" x:Name="BodyBox" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="16" FontSize="{DynamicResource FontSize14}" VerticalContentAlignment="Top"/>
    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="添加附件" Click="OnAttach"/><TextBlock x:Name="AttachmentLabel" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0"/></StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="取消" Click="OnCancel" Margin="0,0,8,0"/><Button Content="发送邮件" Style="{StaticResource AccentButton}" Click="OnSend"/></StackPanel>
  </Grid>
</Window>
