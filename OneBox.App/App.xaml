<Application x:Class="OneBox.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OneBox.App" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary xmlns:sys="clr-namespace:System;assembly=mscorlib">
      <local:StatusTextConverter x:Key="StatusTextConverter"/>
      <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
      <SolidColorBrush x:Key="CanvasBrush" Color="#F7F9FC"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="#E9EFF7"/>
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#CBDDF8"/>
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="#DFE9F7"/>
      <SolidColorBrush x:Key="InkBrush" Color="#111D32"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#4D596C"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#185BCC"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#114BAE"/>
      <SolidColorBrush x:Key="LineBrush" Color="#DEE4ED"/>
      <SolidColorBrush x:Key="SelectedBrush" Color="#E6EFFD"/>
      <SolidColorBrush x:Key="HoverBrush" Color="#F0F5FC"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#935616"/>
      <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF7E9"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="#297968"/>
      <DrawingImage x:Key="FavoriteIcon">
        <DrawingImage.Drawing><DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
          <GeometryDrawing Brush="#F6BB50" Geometry="M12,5 L14.4,10 L20,10.8 L16,14.7 L17,20.2 L12,17.6 L7,20.2 L8,14.7 L4,10.8 L9.6,10 Z">
            <GeometryDrawing.Pen><Pen Brush="#A36217" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing>
      </DrawingImage>
      <DrawingImage x:Key="UnfavoriteIcon">
        <DrawingImage.Drawing><DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z"/>
          <GeometryDrawing Geometry="M12,5 L14.4,10 L20,10.8 L16,14.7 L17,20.2 L12,17.6 L7,20.2 L8,14.7 L4,10.8 L9.6,10 Z">
            <GeometryDrawing.Pen><Pen Brush="{StaticResource MutedBrush}" Thickness="1.2" LineJoin="Round"/></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing>
      </DrawingImage>
      <CornerRadius x:Key="ControlRadius">6</CornerRadius>
      <CornerRadius x:Key="PanelRadius">12</CornerRadius>
      <Geometry x:Key="SearchGlyph">M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 1 0 10.5,3 M16,16 L22,22</Geometry>
      <Geometry x:Key="PencilGlyph">M3,21 L5,14 L16,3 Q18,1 21,4 Q23,6 21,8 L10,19 Z M14,5 L19,10 M5,14 L10,19</Geometry>
      <Geometry x:Key="InboxGlyph">M2,13 L5,4 H19 L22,13 V20 H2 Z M2,13 H8 L9,16 H15 L16,13 H22</Geometry>
      <Geometry x:Key="StarGlyph">M12,2 L15,8.5 L22,9.5 L17,14.5 L18,22 L12,18.5 L6,22 L7,14.5 L2,9.5 L9,8.5 Z</Geometry>
      <Geometry x:Key="MailGlyph">M2,5 H22 V19 H2 Z M2,6 L12,14 L22,6</Geometry>
      <Geometry x:Key="RefreshGlyph">M21,9 A9,9 0 0 0 4,7 M21,3 V9 H15 M3,15 A9,9 0 0 0 20,17 M3,21 V15 H9</Geometry>
      <Geometry x:Key="DownloadGlyph">M12,2 V15 M7,10 L12,15 L17,10 M3,16 V21 H21 V16</Geometry>
      <Style x:Key="OutlineGlyph" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}"/>
        <Setter Property="StrokeThickness" Value="1.75"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="17"/>
        <Setter Property="Height" Value="17"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <sys:Double x:Key="FontSize10">10</sys:Double>
      <sys:Double x:Key="FontSize11">11</sys:Double>
      <sys:Double x:Key="FontSize12">12</sys:Double>
      <sys:Double x:Key="FontSize13">13</sys:Double>
      <sys:Double x:Key="FontSize14">14</sys:Double>
      <sys:Double x:Key="FontSize19">19</sys:Double>
      <sys:Double x:Key="FontSize20">20</sys:Double>
      <sys:Double x:Key="FontSize23">23</sys:Double>
      <sys:Double x:Key="FontSize25">25</sys:Double>
      <sys:Double x:Key="FontSize27">27</sys:Double>
      <sys:Double x:Key="BodyLineHeight">26</sys:Double>
      <sys:Double x:Key="HelpLineHeight">22</sys:Double>
      <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize13}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      </Style>
      <Style x:Key="PopupTextRendering" TargetType="FrameworkElement">
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
      </Style>
      <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize13}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
      </Style>
      <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize13}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
      </Style>
      <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                  <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </MultiTrigger>
                <Trigger Property="Background" Value="{StaticResource SelectedBrush}"><Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"
                      BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource InkBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      </Style>
      <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="11,7"/>
      </Style>
      <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"/>
      </Style>
      <Style x:Key="ReaderAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,7"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
      </Style>
      <Style x:Key="ReaderPrimaryAction" TargetType="Button" BasedOn="{StaticResource ReaderAction}">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource ControlRadius}">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Padding" Value="0"/>
      </Style>
      <Style x:Key="MailScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Border Background="#9BAAC0" CornerRadius="2.5"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
            <Setter Property="Opacity" Value="1"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SidebarItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarSelectedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MailRowText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize14}"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsUnread}" Value="True">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="MailItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid>
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Margin="17,0,17,0"/>
                <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                        CornerRadius="{StaticResource ControlRadius}" Margin="9,2">
                  <ContentPresenter/>
                </Border>
                <Ellipse Fill="{StaticResource AccentBrush}" Width="12" Height="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,20,0,0" IsHitTestVisible="False"
                        Visibility="{Binding IsUnread, Converter={StaticResource BoolVisibility}}"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource LineBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="{x:Static local:App.ColumnResizeCursor}"/>
        <Style.Triggers>
          <Trigger Property="ResizeDirection" Value="Rows"><Setter Property="Cursor" Value="{x:Static local:App.RowResizeCursor}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
